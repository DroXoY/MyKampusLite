<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Form Input Dosen -->
    <EditText android:id="@+id/etNamaDosen"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nama (Min 3 Karakter)" />
    <EditText android:id="@+id/etEmailDosen"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email" android:inputType="textEmailAddress" />
    <EditText android:id="@+id/etNidn"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="NIDN" />
    <EditText android:id="@+id/etMatkul"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Jumlah Mata Kuliah Diampu" android:inputType="number" />

    <!-- Tombol Simpan -->
    <Button android:id="@+id/btnSimpanDosen"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Simpan Dosen" android:layout_marginTop="8dp"/>

    <!-- Daftar Data (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDosen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"/>
</LinearLayout>